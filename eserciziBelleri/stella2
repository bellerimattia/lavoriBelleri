<html>
<body>
<canvas id="myCanvas" width="300" height="200" style="border:1px solid #000;"></canvas>
<script>
const canvas = document.getElementById("myCanvas");
const ctx = canvas.getContext("2d");
ctx.beginPath();
ctx.moveTo(150,20);
ctx.lineTo(185,160);
ctx.lineTo(95,70);
ctx.lineTo(205,70);
ctx.lineTo(115,160);
ctx.lineTo(150,20);
ctx.stroke();
ctx.beginPath();
ctx.arc(150,100,80,0,2*Math.PI);
ctx.stroke();
</script>
</body>
</html>
